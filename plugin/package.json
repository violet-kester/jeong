{
	"name": "jeong-obsidian-plugin",
	"version": "0.1.5",
	"description": "Jeong for Obsidian: record your thoughts and see them on a timeline, all locally.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"web": "node web/build.mjs --serve",
		"web:build": "node web/build.mjs",
		"lint": "eslint ."
	},
	"keywords": [],
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"lucide": "^1.61.0",
		"moment": "^2.31.0",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"author": "Violet Kester",
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"@huggingface/transformers": "^4.3.1"
	}
}
